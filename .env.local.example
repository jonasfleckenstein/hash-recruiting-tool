# Copy this file to .env.local and fill in the values.
# .env.local is gitignored, so keys never leave your machine.

# Used for intake suggestions (Haiku) and later for scoring and outreach drafts.
ANTHROPIC_API_KEY=

# Used for job-title autocomplete (free, no credits) and for candidate search
# in step 2 (0.03 credits per result). Optional: without it the title input
# falls back to a short local list.
CRUSTDATA_API_KEY=

# Used to read public contribution history for enriched candidates who have a
# GitHub handle. Free: public data costs nothing, and 5,000 points an hour is
# roughly a hundred times what a cohort needs.
#
# A classic personal access token with NO scopes ticked. Everything this tool
# reads is public: contributions, merged pull requests, repositories, social
# accounts. If GitHub warns that the token has no scopes, that is correct.
# Create one at https://github.com/settings/tokens
#
# The GraphQL API cannot be called unauthenticated at all, so without this the
# GitHub step is skipped rather than degraded.
GITHUB_TOKEN=
