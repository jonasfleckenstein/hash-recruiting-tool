# Copy this file to .env.local and fill in the values.
# .env.local is gitignored, so keys never leave your machine.

# Used for intake suggestions (Haiku) and later for scoring and outreach drafts.
ANTHROPIC_API_KEY=

# Used for job-title autocomplete (free, no credits) and for candidate search
# in step 2 (0.03 credits per result). Optional: without it the title input
# falls back to a short local list.
CRUSTDATA_API_KEY=
